#!/bin/bash

#
# Script that creates BTRFS snapshots, manually or from cron
#
# Usage:
#         sudo btrfs-snp  <dir> (<tag>) (<limit>) (<seconds>) (<destdir>)
#
# Copyleft 2017 by Ignacio Nunez Hernanz <nacho _a_t_ ownyourbits _d_o_t_ com>
# GPL licensed (see end of file) * Use at your own risk!
#
# Based on btrfs-snap by Birger Monsen
#
# More at https://ownyourbits.com
#

function btrfs-snp()
{
  local   BIN="${0##*/}"
  local   DIR="${1}"
  local   TAG="${2:-snapshot}"
  local LIMIT="${3:-0}"
  local   TIME="${4:-0}"
  local   DST="${5:-.snapshots}"
  local MARGIN=15 # allow for some seconds of inaccuracy for cron / systemd timers

  ## usage
  [[ "$*" == "" ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]] && {
    echo "Usage: $BIN <dir> (<tag>) (<limit>) (<seconds>) (<destdir>)

  dir     │ create snapshot of <dir>
  tag     │ name the snapshot <tag>_<timestamp>
  limit   │ keep <limit> snapshots with this tag. 0 to disable
  seconds │ don't create snapshots before <seconds> have passed from last with this tag. 0 to disable
  destdir │ store snapshot in <destdir>, path absolute or relative to <dir>

Cron example: Hourly snapshot for one day, daily for one week, weekly for one month, and monthly for one year.

cat > /etc/cron.hourly/$BIN <<EOF
#!/bin/bash
/usr/local/sbin/$BIN /home hourly  24 3600
/usr/local/sbin/$BIN /home daily    7 86400
/usr/local/sbin/$BIN /home weekly   4 604800
/usr/local/sbin/$BIN /     weekly   4 604800
/usr/local/sbin/$BIN /home monthly 12 2592000
EOF
chmod +x /etc/cron.hourly/$BIN"
    return 0
  }

  ## checks
  exec 200>"/var/lock/${BIN}.lock"
  flock -n 200 || { echo "Another instance of $BIN is already running"; return 1; }

  [[ ${EUID} -ne 0  ]] && { echo "Must be run as root. Try 'sudo $BIN'"; return 1; }

  mount -t btrfs | cut -d' ' -f3 | grep -q "^${DIR}$" || {
    btrfs subvolume show "$DIR" &>/dev/null || {
      echo "$DIR is not a BTRFS mountpoint or snapshot"
      return 1
    }
  }

  [[ "$DST" = /* ]] || DST="$DIR/$DST"
  mkdir -p "$DST" || { echo "Failed to create destination directory $DST"; return 1; }

  # Explicit filesystem boundary validation for BTRFS snapshots
  local src_fs dest_fs
  src_fs=$(stat -f -c %T "$DIR" 2>/dev/null || stat -f %T "$DIR" 2>/dev/null)
  dest_fs=$(stat -f -c %T "$DST" 2>/dev/null || stat -f %T "$DST" 2>/dev/null)

  if [[ "$src_fs" != "btrfs" ]] || [[ "$dest_fs" != "btrfs" ]]; then
    echo "Error: Both source ($DIR) and destination ($DST) must reside on a BTRFS filesystem"
    return 1
  fi

  local SNAPS=()
  while IFS= read -r -d $'\0' snap; do
    [[ -n "$snap" ]] && SNAPS+=("$snap")
  done < <(find "$DST" -mindepth 1 -maxdepth 1 -name "${TAG}_*" -print0 | sort -z)

  ## check time of the last snapshot for this tag with robust regex validation
  if [[ "$TIME" -ne 0 ]] && [[ ${#SNAPS[@]} -gt 0 ]]; then
    local latest_path="${SNAPS[-1]}"
    local latest_name="${latest_path##*/}"
    
    if [[ "$latest_name" =~ _([0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{6})$ ]]; then
      local ts_str="${BASH_REMATCH[1]}"
      local formatted_ts="${ts_str:0:10} ${ts_str:11:2}:${ts_str:13:2}:${ts_str:15:2}"
      local latest_epoch
      latest_epoch=$(date +%s -d "$formatted_ts" 2>/dev/null)

      if [[ -n "$latest_epoch" ]]; then
        local current_epoch=$(date +%s)
        if [[ $(( latest_epoch + TIME )) -gt $(( current_epoch + MARGIN )) ]]; then
          echo "No new snapshot needed for $TAG in $DIR"
          return 0
        fi
      fi
    fi
  fi

  local SNAPSHOT="${TAG}_$(date +%F_%H%M%S)"
  local target_snapshot="$DST/$SNAPSHOT"

  [[ -e "$target_snapshot" ]] && { echo "$target_snapshot already exists"; return 1; }

  ## do it
  btrfs subvolume snapshot -r "$DIR" "$target_snapshot" || {
    echo "Error: Failed to create read-only snapshot. Check available disk space and filesystem health."
    return 1
  }
  SNAPS+=("$target_snapshot")

  ## prune older backups safely
  [[ "$LIMIT" != 0 ]] && [[ ${#SNAPS[@]} -gt $LIMIT ]] && {
    echo "Pruning old snapshots..."
    local excess=$(( ${#SNAPS[@]} - LIMIT ))
    for (( i=0; i < excess; i++ )); do
      if [[ -d "${SNAPS[$i]}" ]]; then
        btrfs subvolume delete "${SNAPS[$i]}"
      fi
    done
  }

  echo "snapshot $SNAPSHOT generated"
}

btrfs-snp "$@"

